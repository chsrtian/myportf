---
import { portfolio } from '../data/portfolio.js';
const { owner } = portfolio;
---
<section id="about" class="section">
  <div class="container card animate-on-scroll">
    <div class="about-grid">
      <div class="about-image">
        <img src={owner.profileImage} alt={`Photo of ${owner.name}`} width="240" height="240" loading="lazy" />
      </div>
      <div class="about-text">
        <h3>About Me</h3>
        <p>{owner.tagline}</p>
        <p>Currently studying BS Information Technology at Caraga State University Cabadbaran Campus. Based in Ampayon, Butuan City, Philippines.</p>
      </div>
    </div>
  </div>
</section>
